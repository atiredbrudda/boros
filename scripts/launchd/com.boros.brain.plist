<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
          "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.boros.brain</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/macbookair/boros/scripts/boros-brain-wrapper.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/macbookair/boros</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- KeepAlive: restart on any exit EXCEPT clean exit 0 -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- ThrottleInterval: min seconds between restarts (default 10; raise to 30 to avoid fork storms) -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- Capture stdout/stderr; anything escaping structlog lands here -->
    <key>StandardOutPath</key>
    <string>/Users/macbookair/boros/var/logs/supervisor/brain.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/macbookair/boros/var/logs/supervisor/brain.stderr.log</string>

    <!-- Environment: minimal; secrets resolved by wrapper via Keychain -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/macbookair</string>
    </dict>
</dict>
</plist>
